*.pyc

# Demo analysis output (generated at runtime)
demos/*/*/output/
demos/.run-start

# Demo data files (generated locally, not committed)
demos/*/data/

# Downloaded binaries (fetched at runtime, not committed)
demos/*/.bin/

# Local review artifacts
.local/
REVIEW*.md

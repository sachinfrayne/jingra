FROM demo-metrics
| WHERE `system.cpu.utilization` IS NOT NULL AND state == "user"
| STATS avg_cpu = avg(`system.cpu.utilization`),
        max_cpu = max(`system.cpu.utilization`),
        min_cpu = min(`system.cpu.utilization`),
        median_cpu = median(`system.cpu.utilization`)
  BY `host.name`
| SORT avg_cpu DESC
| LIMIT {{size}}
